        serial id PK
        varchar name UK
    }
    LOCATIONS {
        serial id PK
        varchar name UK
    }
    ITEMS {
        uuid id PK
        uuid reporter_id FK
        varchar kind
        varchar title
        varchar description
        int category_id FK
        int location_id FK
        date event_date
        varchar color
        varchar status
        text reference_code UK
        tsvector search_vector
    }
    CLAIMS {
        uuid id PK
        uuid item_id FK
        uuid claimant_id FK
        uuid linked_lost_id FK
        varchar statement
        varchar status
        uuid reviewer_id FK
        varchar review_note
    }
