# Copy to .env. These are local Docker demo settings, not production secrets.
DATABASE_URL=postgresql://campus:campus_local_password@localhost:5432/campus_lost_found
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=campus_lost_found
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Set a different password before seeding; used for all synthetic demo accounts.
DEMO_PASSWORD=CampusDemo@2026
# Tests refuse to run without this flag and a database name ending in _test.
ALLOW_TEST_DATABASE=false
